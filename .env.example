# Intervalo de monitoramento em minutos (padrao: 30 minutos para economizar recursos e evitar bloqueios)
CHECK_INTERVAL_MINUTES=30

# Cooldown em minutos antes de reenviar alerta do mesmo produto se o preco continuar abaixo do alvo
ALERT_COOLDOWN_MINUTES=240

# Quantidade maxima de resultados exibidos em uma busca (!buscar)
MAX_SEARCH_RESULTS=5

# Nivel de log do Baileys/App (silent, error, warn, info)
LOG_LEVEL=warn
