{
  "name": "alerta-de-precos",
  "version": "1.0.0",
  "description": "Monitor leve de preços e buscador de ofertas via WhatsApp (Baileys) para rodar no PC",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "cheerio": "^1.2.0",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
